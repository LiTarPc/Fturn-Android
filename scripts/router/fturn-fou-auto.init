#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=9
start_service() {
    [ -s /etc/fturn-fou-auto.key ] || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/fturn-fou-auto --daemon
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 8
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() { /usr/sbin/fturn-fou-auto --stop; }
