<resources>
    <style name="Base.Theme.FreeTurn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/app_primary</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.FreeTurn" parent="Base.Theme.FreeTurn" />
    <style name="Theme.FreeTurn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.FreeTurn</item>
    </style>
</resources>
